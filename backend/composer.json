{
    "name": "apprentissage-js/backend",
    "description": "Backend API for Apprentissage JavaScript Learning Platform",
    "type": "project",
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^6.10",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
