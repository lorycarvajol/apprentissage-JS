# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=apprentissage_js
DB_USER=root
DB_PASS=

# JWT Configuration
# Générer une valeur forte avec : php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=your-secret-key-change-this-in-production
# Durée de vie de l'access token en secondes (courte : le refresh token httpOnly prend le relais)
JWT_EXPIRATION=900

# API Configuration
API_URL=http://localhost:8010
FRONTEND_URL=http://localhost:5200

# CORS Configuration
CORS_ORIGIN=http://localhost:5200

# Environment
APP_ENV=development
APP_DEBUG=true

# Pas de PHP_CLI_PATH ici : contrairement au projet PHP jumeau, le code JS
# soumis par l'apprenant s'exécute côté client (sandbox Web Worker dans le
# navigateur, voir frontend/src/utils/jsSandbox.js) — il n'y a pas de
# sandbox d'exécution côté serveur dans ce projet.

# Mail Configuration (Mailtrap sandbox - https://mailtrap.io, ou tout autre SMTP)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@apprentissage-js.local
MAIL_FROM_NAME="Plateforme Apprentissage JavaScript"
