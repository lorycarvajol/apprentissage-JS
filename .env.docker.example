# Configuration de déploiement — à copier en `.env.docker` sur le VPS et à
# remplir avec les vraies valeurs. Ce fichier-ci (l'exemple) est versionné ;
# `.env.docker`, lui, est ignoré par git et ne doit JAMAIS être commité.
#
#   cp .env.docker.example .env.docker
#   chmod 600 .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# Les valeurs sont lues deux fois : par docker compose pour l'interpolation des
# ${VARIABLES} du docker-compose.yml, et par le conteneur backend via
# `env_file` (php-fpm les expose à $_ENV grâce à clear_env=no, cf.
# docker/php/zz-pool.conf).

# ============================================================================
# Domaine et routage Traefik
# ============================================================================
APP_DOMAIN=js.lorycarvajol.dev

# Noms des réseaux Docker partagés du VPS. Les deux existent déjà et ne sont PAS
# gérés par ce compose : `proxy` est celui de Traefik, `mysql-shared` celui de
# l'instance MySQL mutualisée (voisine de tapistyle).
TRAEFIK_NETWORK=proxy
DB_NETWORK=mysql-shared

# Doivent correspondre à la configuration statique de Traefik. Attention :
# le resolver ACME du VPS s'appelle `myresolver`, pas `letsencrypt`.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=myresolver

# ============================================================================
# Base de données — instance MySQL mutualisée du VPS
# ============================================================================
# DB_HOST = nom du conteneur MySQL sur le réseau `mysql-shared`. L'alias réseau
# `mysql` y répond aussi ; le nom complet est retenu parce que c'est celui que
# tapistyle utilise déjà et qu'il est vérifié.
DB_HOST=mysql-shared-mysql-1
DB_PORT=3306
DB_NAME=apprentissage_js

# Utilisateur DÉDIÉ à ce projet, distinct de celui de apprentissage-POO-PHP :
# l'instance est mutualisée, pas les permissions. Créé par
# docker/mysql/init-apprentissage-js.sql.
DB_USER=apprentissage_js
DB_PASS=

# Délai d'attente maximal de MySQL au démarrage du conteneur, en secondes.
DB_WAIT_TIMEOUT=60

# Jouer database/migrate.php au démarrage du conteneur backend. À laisser sur
# `true` : le script est idempotent, et c'est ce qui applique le schéma au
# déploiement sans intervention manuelle.
RUN_MIGRATIONS=true

# ============================================================================
# JWT
# ============================================================================
# Générer une valeur unique pour la production, jamais réutilisée depuis le
# développement ni depuis le projet PHP jumeau :
#   php -r "echo bin2hex(random_bytes(32));"
# ou, sans PHP sous la main :
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=900

# ============================================================================
# URLs publiques
# ============================================================================
# Front et API partagent la même origine (nginx sert le SPA et transmet /api à
# php-fpm) : ces deux valeurs pointent donc sur le même domaine.
API_URL=https://js.lorycarvajol.dev
FRONTEND_URL=https://js.lorycarvajol.dev

# ============================================================================
# CORS
# ============================================================================
# Liste blanche stricte, séparée par des virgules. En pratique, aucune requête
# du SPA ne déclenche de CORS ici puisqu'elle est same-origin — cette valeur ne
# sert que de garde-fou pour tout appel externe.
# En APP_ENV=production, les origines localhost ne sont PLUS acceptées
# automatiquement (cf. backend/src/Config/Cors.php).
CORS_ORIGIN=https://js.lorycarvajol.dev

# ============================================================================
# Environnement
# ============================================================================
# Rappel : docker-compose.yml force APP_ENV=production et APP_DEBUG=false pour
# les conteneurs, quoi qu'il y ait ici. Ces lignes ne sont là que pour être
# explicite sur la cible.
APP_ENV=production
APP_DEBUG=false

# ============================================================================
# Envoi d'e-mails (vérification de compte, réinitialisation de mot de passe)
# ============================================================================
# Mailtrap ne convient qu'au développement (les mails n'arrivent jamais aux
# destinataires réels) : en production, utiliser un vrai relais SMTP.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@lorycarvajol.dev
MAIL_FROM_NAME="Plateforme Apprentissage JavaScript"
